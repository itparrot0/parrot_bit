{
  "name": "@bloom-wave/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify-pack && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "e2e": "playwright test",
    "cap:sync": "npm run build && cap sync android",
    "icons": "node ../tools/levelgen/src/icon.ts assets && capacitor-assets generate --android",
    "android:debug": "npm run cap:sync && cd android && gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && gradlew bundleRelease",
    "verify-pack": "node ../tools/levelgen/src/cli.ts verify src/levels/pack-01.json"
  },
  "dependencies": {
    "@bloom-wave/core": "*",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
